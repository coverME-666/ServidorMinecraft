QWidget {
    font-size: 15px;
    background: #23272e;
    color: #e0e0e0;
    font-family: 'Segoe UI', Arial, sans-serif;
}

/* Crear servidor */
#groupCrearServidor {
    margin-top: 24px;
    padding: 24px;
}

/* Aumentar el espaciado de los campos */
#groupCrearServidor QLineEdit, #groupCrearServidor QComboBox {
    min-height: 40px;
    padding: 12px 16px;
    margin-bottom: 12px;
}

/* Configuración del mundo: ocupa todo el alto */
#scrollConfigMundo {
    min-height: 100%;
}

/* Gestión de mundos */
#groupGestionMundos {
    margin-top: 32px;
}

/* Caja principal genérica */
QGroupBox {
    border: none;
    border-radius: 16px;
    margin-top: 16px;
    background: #2c313a;
    padding: 16px 24px;
    box-shadow: none;
}

/* Título sin sombra ni efecto */
QGroupBox:title {
    subcontrol-origin: margin;
    subcontrol-position: top center;
    left: 0px;
    right: 0px;
    padding: 8px 12px 0 12px;
    color: #7ee787;
    font-weight: bold;
    font-size: 18px;
    letter-spacing: 1px;
    background: transparent;
    margin-top: 0px;
    font-family: 'Segoe UI', Arial, sans-serif;
}

/* ScrollArea y su viewport con borde redondeado */
QScrollArea {
    border: none;
    background: transparent;
    border-radius: 16px;
}
QScrollArea > QWidget {
    border-radius: 16px;
    background: transparent;
}
QAbstractScrollArea::viewport {
    border-radius: 16px;
    background: transparent;
}

/* Forzar color blanco puro en textos importantes */
QLabel, QCheckBox, QRadioButton, QPushButton, QGroupBox, QLineEdit, QComboBox, QTextEdit {
    color: #ffffff;
    background: transparent;
}

/* Entradas y combos */
QLineEdit, QComboBox, QTextEdit {
    background: #23272e;
    border: 2px solid #3a3f4b;
    border-radius: 8px;
    padding: 10px 16px;
    font-size: 15px;
    color: #e0e0e0;
    font-family: 'Segoe UI', Arial, sans-serif;
}

/* QComboBox sin flecha ni drop-down */
QComboBox {
    background: #23272e;
    border: 2px solid #3a3f4b;
    border-radius: 8px;
    padding: 10px 16px;
    font-size: 15px;
    color: #e0e0e0;
    min-width: 120px;
    font-family: 'Segoe UI', Arial, sans-serif;
}
QComboBox::drop-down {
    width: 0px;
    border: none;
    background: transparent;
    margin: 0;
    padding: 0;
}
QComboBox::down-arrow {
    width: 0px;
    height: 0px;
    image: none;
    margin: 0;
    padding: 0;
    border: none;
    background: transparent;
}
QComboBox QAbstractItemView {
    background: #23272e;
    border: 2px solid #3a3f4b;
    selection-background-color: #31363f;
    color: #e0e0e0;
    border-radius: 8px;
    font-family: 'Segoe UI', Arial, sans-serif;
}

/* Botón */
QPushButton {
    background-color: #3a3f4b;
    color: #7ee787;
    border: none;
    border-radius: 12px;
    padding: 10px 22px;
    font-weight: bold;
    font-family: 'Segoe UI', Arial, sans-serif;
    font-size: 15px;
    letter-spacing: 1px;
    transition: background 0.2s;
}
QPushButton:hover {
    background-color: #50576a;
    color: #fff;
}

/* CheckBox */
QCheckBox {
    spacing: 10px;
    font-size: 15px;
    color: #e0e0e0;
    font-family: 'Segoe UI', Arial, sans-serif;
}
QCheckBox::indicator {
    width: 22px;
    height: 22px;
    border: 2px solid #7ee787;
    border-radius: 6px;
    background: #23272e;
}
QCheckBox::indicator:checked {
    background: #7ee787;
    image: none;
}

/* Terminal más estrecha */
QTextEdit#terminalBox {
    background: #181c20;
    color: #7ee787;
    border-radius: 12px;
    border: 2px solid #3a3f4b;
    padding: 10px;
    font-family: 'Consolas', monospace;
    font-size: 14px;
    min-width: 80px; /* Mantengo 80px como pediste */
    min-height: 100px;
}

/* ScrollBar */
QScrollBar:vertical {
    background: #23272e;
    width: 14px;
    margin: 4px 2px 4px 2px;
    border-radius: 7px;
    border: 1px solid #3a3f4b;
}
QScrollBar::handle:vertical {
    background: #7ee787;
    min-height: 32px;
    border-radius: 7px;
}
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical {
    background: none;
}
QScrollBar:horizontal {
    height: 0px;
    background: transparent;
    border: none;
}
