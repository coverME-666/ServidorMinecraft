QWidget {
    font-size: 15px;
    /* background: #fff; */ /* <- Elimina o comenta esta línea */
    color: #145a32;
}

/* Grupos con efecto pixel-art */
QGroupBox#serverGroup, QGroupBox#worldGroup {
    border: 4px solid #4CAF50;
    border-radius: 0px;
    margin-top: 0px;
    background: #fff;
    padding: 5px 40px 5px 40px; /* Aumenta el padding lateral */
    box-shadow: none;
}

QGroupBox#serverGroup:title, QGroupBox#worldGroup:title {
    subcontrol-origin: margin;
    subcontrol-position: top center;
    left: 0px;
    right: 0px;
    padding: 18px 12px 0 12px;
    color: #219150;
    font-weight: bold;
    font-size: 21px;
    letter-spacing: 1px;
    background: transparent;
    margin-top: 0px;
    font-family: 'Press Start 2P', 'Consolas', monospace;
    text-shadow: 2px 2px 0 #4CAF50;
}

QScrollArea {
    border: none;
    background: transparent;
}

QLineEdit, QComboBox, QTextEdit {
    background: #fff;
    border: 3px solid #4CAF50;
    border-radius: 0px;
    padding: 10px 16px;
    font-size: 15px;
    color: #145a32;
    font-family: 'Consolas', monospace;
}

QComboBox {
    background: #fff;
    border: 3px solid #4CAF50;
    border-radius: 0px;
    padding: 10px 16px;
    font-size: 15px;
    color: #145a32;
    min-width: 120px;
    font-family: 'Consolas', monospace;
}

QComboBox::drop-down {
    border: none;
    background: transparent;
    width: 24px; /* Mantiene la proporción original */
    margin: 0;
    padding: 0;
}

QComboBox::down-arrow {
    width: 0px;
    height: 0px;
    image: none;
    margin: 0;
    padding: 0;
    border: none;
    background: transparent;
}

QComboBox QAbstractItemView {
    background: #fff;
    border: 3px solid #4CAF50;
    selection-background-color: #e8f5e9;
    color: #145a32;
    border-radius: 0px;
    font-family: 'Consolas', monospace;
}

QPushButton {
    background-color: #fff;
    color: #219150;
    border: 4px solid #4CAF50;
    border-radius: 0px;
    padding: 10px 22px;
    font-weight: bold;
    font-family: 'Press Start 2P', 'Consolas', monospace;
    font-size: 15px;
    letter-spacing: 1px;
}
QPushButton:hover {
    background-color: #e8f5e9;
    color: #145a32;
    border: 4px solid #219150;
}

QCheckBox {
    spacing: 10px;
    font-size: 15px;
    color: #145a32;
    font-family: 'Consolas', monospace;
}
QCheckBox::indicator {
    width: 22px;
    height: 22px;
    border: 3px solid #4CAF50;
    border-radius: 0px;
    background: #fff;
}
QCheckBox::indicator:checked {
    background: #4CAF50;
    image: none;
}

QTextEdit#terminalBox {
    background: #145a32;
    color: #b9f6ca;
    border-radius: 0px;
    border: 4px solid #4CAF50;
    padding: 25px;
    font-family: 'Consolas', monospace;
    font-size: 14px;
    min-width: 280px;
    min-height: 160px;
}

QScrollBar:vertical {
    background: #fff;
    width: 18px;
    margin: 4px 2px 4px 2px;
    border-radius: 0px;
    border: 3px solid #4CAF50;
}
QScrollBar::handle:vertical {
    background: #4CAF50;
    min-height: 32px;
    border-radius: 0px;
}
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical {
    background: none;
}

/* Oculta solo la barra de scroll horizontal */
QScrollBar:horizontal {
    height: 0px;
    background: transparent;
    border: none;
}
QGroupBox#gestionGroup {
    border: 4px solid #4CAF50;
    border-radius: 0px;
    margin-top: 0px;
    background: #fff;
    padding-top: 18px;
    box-shadow: none;
}

QGroupBox#gestionGroup:title {
    subcontrol-origin: margin;
    subcontrol-position: top center;
    left: 0px;
    right: 0px;
    padding: 18px 12px 0 12px;
    color: #219150;
    font-weight: bold;
    font-size: 21px;
    letter-spacing: 1px;
    background: transparent;
    margin-top: 0px;
    font-family: 'Press Start 2P', 'Consolas', monospace;
    text-shadow: 2px 2px 0 #4CAF50;
}
